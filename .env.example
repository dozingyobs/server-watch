# Required
DISCORD_TOKEN=your-bot-token-here

# Where alerts go: set ONE of these (channel wins if both are set)
ALERT_CHANNEL_ID=0
ALERT_USER_ID=0

# Thresholds (defaults shown)
TEMP_LIMIT_C=80
CPU_LIMIT=90
RAM_LIMIT=90
DISK_LIMIT=90
NET_LIMIT_MBIT=50

# Behaviour
CHECK_INTERVAL=30      # seconds between checks
SUSTAIN_CHECKS=3       # consecutive breaches before alerting (avoids spikes)
ALERT_COOLDOWN=900     # seconds before the same alert repeats
