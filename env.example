# Required
DISCORD_TOKEN=your-bot-token-here

# Where alerts go: set ONE of these (channel wins if both are set)
ALERT_CHANNEL_ID=0
ALERT_USER_ID=0

# Thresholds (defaults shown)
TEMP_LIMIT_C=80
CPU_LIMIT=90
RAM_LIMIT=90
DISK_LIMIT=90
NET_LIMIT_MBIT=50

# Behaviour
CHECK_INTERVAL=30      # seconds between checks
SUSTAIN_CHECKS=3       # consecutive breaches before alerting (avoids spikes)
ALERT_COOLDOWN=900     # seconds before the same alert repeats

# Power estimate (shown in /status and alert footers)
# If the CPU exposes real power readings (Intel/AMD RAPL) those are used.
# Otherwise power is estimated from CPU load using the two numbers below.
# Set them to your server's real idle / full-load wall power if you know it.
POWER_IDLE_W=15
POWER_MAX_W=60
POWER_OTHER_W=0        # watts to add to a CPU-only reading (board, disks, fans)
PRICE_PER_KWH=0        # your electricity price per kWh; 0 = don't show cost
CURRENCY=$             # symbol shown next to the cost
