# ---- Required ----
DISCORD_TOKEN=your-bot-token-here

# Where alerts go: set ONE of these (channel wins if both are set)
ALERT_CHANNEL_ID=0
ALERT_USER_ID=0

# ---- Optional: everything below has a built-in default ----
# You can also change all of these from Discord with /config (see README).
# A value changed in Discord overrides what is written here.
# Keep comments on their own line, like these.

# Turn alert types on or off (on/off)
ENABLE_TEMP=on
ENABLE_CPU=on
ENABLE_RAM=on
ENABLE_DISK=on
ENABLE_NET=on

# Limits that trigger an alert
TEMP_LIMIT_C=80
CPU_LIMIT=90
RAM_LIMIT=90
DISK_LIMIT=90
# Mbit/s, checked separately for download and upload
NET_LIMIT_MBIT=50

# Timing (seconds, except SUSTAIN_CHECKS)
CHECK_INTERVAL=30
# consecutive checks over a limit before alerting (avoids brief spikes)
SUSTAIN_CHECKS=3
# time before the same alert repeats
ALERT_COOLDOWN=900

# Power estimate: real CPU readings are used if available, otherwise it is
# estimated from CPU load between the idle and max values.
# Set these to your server's real idle / full-load wall power if you know it.
POWER_IDLE_W=15
POWER_MAX_W=60
# extra watts added to a CPU-only reading (board, disks, fans)
POWER_OTHER_W=0
# electricity price per kWh; 0 = don't show cost
PRICE_PER_KWH=0
# symbol shown next to the cost (avoid a bare $, Docker treats it as a variable)
CURRENCY=₱
